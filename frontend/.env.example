# Variables the frontend needs. Don't put real values in this file.
# Copy to .env.development.local (local Supabase) and/or .env.hosted.local (hosted project).
# Sample values and where to get them: see docs/SETUP.md.
#
# Only public values go here. Anything starting with VITE_ is bundled into the browser JS,
# so never put the service_role / secret key or OAuth client secrets in these files.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Cloudflare Turnstile site key (public). CAPTCHA is off for now, so leave this empty.
# When it's turned on, local dev uses 1x00000000000000000000AA (Cloudflare's test key).
VITE_TURNSTILE_SITE_KEY=
