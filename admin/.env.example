# Copy to .env.local. Only public values belong here: anything NEXT_PUBLIC_ is bundled into the browser.
# Never put the service_role / secret key in these files.

# mock (default): in-memory sample data, no backend needed.
# api: the admin-api Supabase Edge Function from branch admin-api/player-be2-integration.
NEXT_PUBLIC_ADMIN_DATA_SOURCE=mock

# Needed when NEXT_PUBLIC_ADMIN_DATA_SOURCE=api. Same values as the player app's VITE_SUPABASE_*.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: sign admins out after this many idle minutes (default 30).
NEXT_PUBLIC_ADMIN_IDLE_TIMEOUT_MINUTES=

# Optional: Mini Leagues are out of scope and hidden. Set to true to show them again (restart the dev server).
NEXT_PUBLIC_ENABLE_MINI_LEAGUES=
