    "/rpc/admin_review_report": {
      "post": {
        "tags": [
          "Admin"
        ],
        "summary": "[Postgres RPC] Admin reviews a report and records an outcome.",
        "x-implementation": "postgres-rpc",
        "description": "Updates Report status (resolved or dismissed) and writes ActivityLog. Does not itself change any account or content — suspending a player, hiding a post or suspending a league is always a separate admin action (admin_suspend_account, admin_hide_post, admin_suspend_league).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "reportId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "outcome": {
                    "type": "string",
                    "enum": [
                      "resolved",
                      "dismissed"
                    ]
                  }
                },
                "required": [
                  "reportId",
                  "outcome"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Report"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/rpc/admin_suspend_account": {
      "post": {
        "tags": [
          "Admin"
        ],
        "summary": "[Edge Function] Admin suspends a player's account.",
        "x-implementation": "edge-function",
        "description": "Elevated-privilege update across Player, GamePost and MiniLeague so a suspended player's active content is hidden; writes ActivityLog. Implemented as a Supabase Edge Function (not a plain Postgres RPC) because it needs the service_role key to update rows the caller does not own across multiple tables — see the Secrets convention above.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "playerId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "reason": {
                    "type": "string"
                  }
                },
                "required": [
                  "playerId",
                  "reason"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
