    "/rpc/resolve_dispute": {
      "post": {
        "tags": [
          "Admin"
        ],
        "summary": "[Postgres RPC] Admin resolves a dispute.",
        "x-implementation": "postgres-rpc",
        "description": "Updates Dispute status and, if upheld, corrects the MatchResult and downstream Ranking; notifies participants.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "disputeId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "outcome": {
                    "type": "string",
                    "enum": [
                      "upheld",
                      "dismissed"
                    ]
                  }
                },
                "required": [
                  "disputeId",
                  "outcome"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Dispute"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    }
  },
  "schemas": {
    "Error": {
      "type": "object",
      "description": "Standard error shape returned to the frontend (see API Specification → Conventions in the Technical Design Document).",
      "properties": {
        "code": {
          "type": "string",
          "description": "Machine-readable error code, e.g. 'forbidden', 'validation_failed', 'not_found'."
        },
        "message": {
          "type": "string",
          "description": "Human-readable error message."
        }
      },
      "required": [
        "code",
        "message"
      ]
    },
    "AdminPost": {
      "type": "object",
      "properties": {
        "adminPostId": {
          "type": "string",
          "format": "uuid",
          "description": "Unique admin post id."
        },
        "title": {
          "type": "string",
          "description": "Headline shown on the home page."
        },
        "body": {
          "type": "string",
          "description": "Body text (announcement, promo, notice)."
        },
        "imageUrl": {
          "type": "string",
          "format": "uri",
          "description": "Image shown on this carousel card, alongside title/body (Supabase Storage public URL). Required to publish (v1.2: the home page carousel is text-and-image, not text-only)."
        },
        "displayOrder": {
          "type": "integer",
          "description": "Position of this card in the home page carousel (ascending; lower shows first). Admin-set; only applied among published items."
        },
        "status": {
          "type": "string",
          "description": "draft | published."
        },
        "createdBy": {
          "type": "string",
          "format": "uuid",
          "description": "Admin who authored this item (FK to player.playerId)."
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time",
          "description": "When status last changed to published (null while draft)."
        }
      },
      "required": [
        "adminPostId"
      ]
    },
    "Report": {
      "type": "object",
      "properties": {
        "reportId": {
          "type": "string",
          "format": "uuid",
          "description": "Unique report id."
        },
        "reportedByPlayerId": {
          "type": "string",
          "format": "uuid",
          "description": "Player who filed the report (FK)."
        },
        "targetType": {
          "type": "string",
          "description": "What is being reported: player | game_post | mini_league."
        },
        "targetId": {
          "type": "string",
          "format": "uuid",
          "description": "Id of the reported player, game post or mini league. Polymorphic — no single FK can reference three different tables, so this is enforced in RLS/RPC logic, not a drawn constraint."
        },
        "reason": {
          "type": "string",
          "description": "Reporter-supplied reason."
        },
        "status": {
          "type": "string",
          "description": "open | reviewing | resolved | dismissed."
        }
      },
      "required": [
        "reportId"
      ]
    },
    "Dispute": {
      "type": "object",
      "properties": {
        "disputeId": {
          "type": "string",
          "format": "uuid",
          "description": "Unique dispute id."
        },
        "matchId": {
          "type": "string",
          "format": "uuid",
          "description": "Disputed match (FK)."
        },
        "reason": {
          "type": "string",
          "description": "Reason for the dispute."
        },
        "status": {
          "type": "string",
          "description": "open | upheld | dismissed."
        }
      },
      "required": [
        "disputeId"
      ]
    }
  }
}
