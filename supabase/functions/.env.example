# Copy to supabase/functions/.env (gitignored) for local Edge Functions.
# Hosted: npx supabase secrets set --env-file supabase/functions/.env

# Must match the vault secret 'email_webhook_secret' in the database.
EMAIL_WEBHOOK_SECRET=change-me-to-a-long-random-string

# Leave empty locally: the function does a dry run and sends nothing.
RESEND_API_KEY=

EMAIL_FROM="Badminton Social Connect <onboarding@resend.dev>"
APP_URL=http://localhost:5173
